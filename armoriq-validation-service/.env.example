# Environment
ENVIRONMENT=development

# ArmorIQ Configuration
ARMORIQ_API_KEY=ak_live_your_api_key_here
ARMORIQ_PROXY_URL=https://customer-proxy.armoriq.ai
ARMORIQ_BACKEND_URL=https://customer-api.armoriq.ai

# Validation Settings
VALIDATION_THRESHOLD=75.0
MAX_TOOL_CALLS=10
EXECUTION_TIMEOUT=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Service Configuration
SERVICE_NAME=ArmorIQ Validation Service
SERVICE_VERSION=1.0.0
PORT=8001

# Optional: Database for audit logging
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/validation_audit